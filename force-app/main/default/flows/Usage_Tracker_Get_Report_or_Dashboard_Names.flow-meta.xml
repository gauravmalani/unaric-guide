<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Do we need to lookup information for Reports or Dashboards?</description>
        <name>Report_or_Dashboard</name>
        <label>Report or Dashboard</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>A_Report</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.iahelp__Context__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00O</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Report_Details</targetReference>
            </connector>
            <label>A Report</label>
        </rules>
        <rules>
            <name>A_Dashboard</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.iahelp__Context__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>01Z</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Dashboard_Details</targetReference>
            </connector>
            <label>A Dashboard</label>
        </rules>
    </decisions>
    <description>A simple Flow to capture the business friendly Names of any Reports or Dashboards a User views (Monitoring the &apos;Context&apos; field) and store it on the triggering Help Interaction record in the &apos;Record Name&apos; field. Enables business friendly analysis.</description>
    <environments>Default</environments>
    <interviewLabel>Usage Tracker | Get Report or Dashboard Names {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Usage Tracker | Get Report or Dashboard Names</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Using the &apos;Context&apos; Help Interaction field, lookup the correct Dashboard and get all fields data</description>
        <name>Get_Dashboard_Details</name>
        <label>Get Dashboard Details</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Store_Dashboard_Name</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Context__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Dashboard</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Using the &apos;Context&apos; Help Interaction field, lookup the correct Report and get all fields data</description>
        <name>Get_Report_Details</name>
        <label>Get Report Details</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Store_Report_Name</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Context__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Report</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Now store the Dashboard Title/Name in the Help Interaction Object &apos;Record Name&apos; field</description>
        <name>Store_Dashboard_Name</name>
        <label>Store Dashboard Name</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>Record_Name__c</field>
            <value>
                <elementReference>Get_Dashboard_Details.Title</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Now store the Report Title/Name in the Help Interaction Object &apos;Record Name&apos; field</description>
        <name>Store_Report_Name</name>
        <label>Store Report Name</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>Record_Name__c</field>
            <value>
                <elementReference>Get_Report_Details.Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Report_or_Dashboard</targetReference>
        </connector>
        <object>HelpInteraction__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
