	<aura:attribute name="Title" type="string" required="true" default="- - -" access="public" />
	<aura:attribute name="Icon" type="string" required="true" default="fa-question" access="public" />
	<aura:attribute name="ActionCode" type="string" required="true" default="AllHelp" access="public" />
