<aura:component controller="ControllerLUXOps" implements="force:appHostable,force:hasRecordId,force:hasSObjectName"
	access="global" extensible="true">

	<!-- 
================================================
Events and Handlers
================================================
-->
<aura:attribute name="lwcComponentGeoLocation" type="Aura.Component"/><!--Attribute to store LWC Geolocation component-->
 
     
   
	<aura:registerEvent name="evtSelectRecord" type="c:selectTopic" />
	<aura:registerEvent name="evtPassThrough" type="c:evtPassThrough" />

     <!-- Messaging channel for communication betwn Lwc and Aura -->
    <lightning:messageChannel aura:id="messageChannel" type="iahelp__MyMessageChannel__c" onMessage="{!c.handleMessage}" Scope="APPLICATION"/>
    
	<aura:handler name="init" value="{!this}" action="{!c.Init}" />
	<aura:handler event="c:evtPassThrough" action="{!c.handlePassThroughs}" />
	<aura:handler event="c:evtNegMenuClick" action="{!c.menuItemClick}" />

	<aura:handler name="change" value="{!v.CardBodyScrollPos}" action="{!c.setScroll}" />
	<aura:attribute name="CardBodyScrollPos" type="integer" required="false" default="0" access="public" />

	<!-- 
................................................
Limited interface for non-cards with access to a 'parent' implementation (eg IHCalloutPrompt)
allowing the former to complete certain actions with assistance of the latter's helper
................................................
-->
	<aura:method name="doDialogue" action="{!c.doDialogue}">
		<aura:attribute name="dlgTitle" type="string" />
		<aura:attribute name="dlgType" type="string" />
		<aura:attribute name="dlgSource" type="string" />
		<aura:attribute name="dlgAttrs" type="object" />
		<aura:attribute name="frmHeight" type="integer" />
		<aura:attribute name="allowScroll" type="boolean" />
		<aura:attribute name="largeMode" type="boolean" />
		<aura:attribute name="showFooter" type="boolean" />
		<aura:attribute name="translateTitle" type="boolean" />
	</aura:method>


	<!-- 
================================================
Internationalised values for use in mark-up
================================================
-->
	<!--  Globals -->
	<aura:attribute name="ButtonCancel" type="string" required="false" default="" access="public" />
	<aura:attribute name="ButtonGotoTemplates" type="string" required="false" default="" access="public" />
	<aura:attribute name="ButtonSave" type="string" required="false" default="" access="public" />
	<aura:attribute name="ButtonQuickSave" type="string" required="false" default="" access="public" />
	<aura:attribute name='FieldLabelAvailable' type='string' required='false' default='' access='public' />
	<aura:attribute name='FieldLabelCreatedBy' type='string' required='false' default='' access='public' />
	<aura:attribute name='FieldLabelCreatedByDT' type='string' required='false' default='' access='public' />
	<aura:attribute name='FieldLabelModifiedBy' type='string' required='false' default='' access='public' />
	<aura:attribute name='FieldLabelModifiedByDT' type='string' required='false' default='' access='public' />
	<aura:attribute name='FieldLabelSelected' type='string' required='false' default='' access='public' />
	<aura:attribute name="MessageGenericTaskComplete" type="string" required="false" default="" access="global" />
	<aura:attribute name="MessageValueRequired" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipButtonClose" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipButtonCompactView" type="string" required="false" default="" access="public" />
	<aura:attribute name="TipButtonConfigureSettings" type="string" required="false" default="" access="public" />
	<aura:attribute name="TipButtonGotoTemplates" type="string" required="false" default="" access="public" />
	<aura:attribute name="TipButtonHelpHome" type="string" required="false" default="" access="public" />
	<aura:attribute name="TipButtonUploadImage" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipGenericCancel" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipGenericDelete" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipGenericEdit" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipGenericOK" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipGoto" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipReadMoreLinkUsers" type="string" required="false" default="" access="global" />
	<aura:attribute name="TipVote" type="string" required="false" default="" access="global" />
	<aura:attribute name="TitleHelpedElement" type="string" required="false" default="" access="global" />

	<aura:attribute name="ToggleHistory" type="string" required="false" default="Toggle History" access="global" />
	<aura:attribute name="BacktoTree" type="string" required="false" default="Back to Tree" access="global" />

	<!-- LUXComponents -->
	<aura:attribute name="AdviceLabelGenericTextPlaceholder" type="string" required="false" default="Modified"
		access="public" />
	<aura:attribute name="AdviceLabelItemsViewed" type="string" required="false" default="Items Viewed" access="public" />
	<aura:attribute name="AdviceLabelModified" type="string" required="false" default="Modified" access="public" />
	<aura:attribute name='AdviceLabelSelectFields' type='string' required='false' default='' access='public' />
	<aura:attribute name="AdviceLabelWorking" type="string" required="false" default="Working..." access="public" />
