									{!v.FieldLabelStepLayout} <ui:inputSelect aura:id="GuidedLayout" multiple="false" change="{!c.setDirty}" >
	                                	<aura:iteration items="{!v.GuidedLayouts}" var="Opt">
	                                        
	                                        <!--  
	                                        NOTE: for "None" drop down entry, we need to use a value that positively
	                                        specifies "null" - as attempting to use a plain null in an option results in
	                                        no discernable value, so the drop down entry can never be reliably selected
	                                        -->
	                                        <ui:inputSelectOption text="{!Opt.Id == null ? v.NullValue : Opt.Id}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__GuidedLayout__c == Opt.Id}" />
