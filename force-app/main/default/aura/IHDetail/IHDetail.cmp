											<ui:inputSelectOption text="Automatic" label="Automatic" value="{!v.CurrentRecord.iahelp__GuideStepMode__c == 'Automatic'}"/>
											<ui:inputSelectOption text="Local" label="Local" value="{!v.CurrentRecord.iahelp__GuideStepMode__c == 'Local'}"/>
											<ui:inputSelectOption text="Manual" label="Manual" value="{!v.CurrentRecord.iahelp__GuideStepMode__c == 'Manual'}"/>
