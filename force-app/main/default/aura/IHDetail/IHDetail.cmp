	            <div class="TabFooter slds-p-horizontal_small">
	                <div class="slds-grid">
	                    <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-2 slds-large-size_1-of-2">
	                            <div class="slds-text-body_small">
									{!v.FieldLabelCreatedBy}: {!v.CurrentRecord.CreatedBy.Name}
									<br/>{!v.FieldLabelCreatedByDT}: <ui:outputDate format="dd-MMM-yy H:mm" value="{!v.CurrentRecord.CreatedDate}" />
	                            </div>
	                    </div>
	                        <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-2 slds-large-size_1-of-2 ">
	                            <div class="slds-text-body_small">
									{!v.FieldLabelModifiedBy}: {!v.CurrentRecord.LastModifiedBy.Name}
									<br/>{!v.FieldLabelModifiedByDT}: <ui:outputDate format="dd-MMM-yy H:mm" value="{!v.CurrentRecord.LastModifiedDate}" />
	                            </div>
	                        </div>
	                </div>
	            </div>
	                
<!-- 
................................................
Save / Cancel controls
................................................
-->
                <div class="slds-grid ">
                    
					<div class="slds-col TabFooterTools slds-size_1-of-1 slds-medium-size_1-of-2 slds-large-size_1-of-2">                    
                        <span class="fa-stack fa-lg IATool BookmarkAdd">
                            <i class="fa fa-circle fa-stack-2x" aria-hidden="true"></i>
							<i id="{! 'Detail' + v.Delimiter + 'Save'}" title="{!v.ButtonSave}" class="fa fa-check fa-stack-1x fa-inverse " onclick="{!c.menuItemClick}" aria-hidden="true" ></i>
                            <span class="sr-only">
								{!v.ButtonSave}
                            </span>
                        </span>                            
            
                        <span class="fa-stack fa-lg IATool">
                            <i class="fa fa-circle fa-stack-2x" aria-hidden="true"></i>
							<i id="{! 'Detail' + v.Delimiter + 'QuickSave'}" title="{!v.ButtonQuickSave}" class="fa fa-check fa-stack-1x fa-inverse" onclick="{!c.menuItemClick}" aria-hidden="true" ></i>
                            <span class="sr-only">
								{!v.ButtonQuickSave}
                            </span>
                        </span>                            

                        <span class="fa-stack fa-lg IATool">
                            <i class="fa fa-circle fa-stack-2x" aria-hidden="true"></i>
							<i id="{! 'Detail' + v.Delimiter + 'Cancel'}" title="{!v.ButtonCancel}" class="fa fa-times fa-stack-1x fa-inverse" onclick="{!c.menuItemClick}" aria-hidden="true" ></i>
                            <span class="sr-only">
								{!v.ButtonCancel}
                            </span>
                        </span>

					</div>

					<div class="slds-col TabFooterTools slds-size_1-of-1 slds-medium-size_1-of-2 slds-large-size_1-of-2">                        
                        <div class="slds-text-body_small IHDetailEditorTopicId">
                        	Id: {!v.CurrentRecord.Id}
                        </div>
					</div>                        

                </div>            
	                
	
		    </div> 		<!-- end of Edit Mode -->
	    
		</aura:if>    <!-- end of IF date mode = EDIT Help Topic -->
    
    </div>
</aura:component>