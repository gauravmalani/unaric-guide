<aura:component controller="ControllerLUXOps" 
				implements="force:appHostable,flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes,lightning:availableForFlowScreens" 
				access="global"  
				extends="IHCard">
	
<!-- 
================================================
Events, Handlers, Attribute sets
================================================
-->	
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:handler event="c:selectTopic" action="{!c.selectRecord}"/>
    <aura:handler event="c:evtPassThrough" action="{!c.handlePassThroughs}"/>

	<aura:handler name="change" value="{!v.DataMode}" action="{!c.initialiseEditingControls}"/>									
	<aura:handler name="change" value="{!v.CurrentRecord}" action="{!c.CurrentRecordChange}"/>									
	<aura:handler name="change" value="{!v.LayoutInfo}" action="{!c.LayoutInfoChange}"/>									
	<aura:handler name="change" value="{!v.IsNonTopic}" action="{!c.ObjectTypeChange}"/>									

    <aura:attribute name="sHTML" type="string" required="false" default="" access="public" />
	<aura:method name="getSafeHTML" action="{!c.getSafeHTML}" />
 
    <aura:set attribute="Title" value="Improved Help - Topic Pending" />
	<aura:set attribute="IHCardType" value="Detail" />    
    <aura:set attribute="Icon" value="fa-question" />

<!-- 
================================================
(Component-specific) internationalisations for mark-up
================================================
-->
    <aura:attribute name="AdviceLabelGuideSettings" type="string" required="false" default="" access="private" />
    <aura:attribute name="AdviceLabelProperties" type="string" required="false" default="" access="private" />
    <aura:attribute name="TipButtonFullSizeImage" type="string" required="false" default="" access="private" />
    <aura:attribute name="TitleTabImage" type="string" required="false" default="" access="private" />
    <aura:attribute name="TitleTabVideo" type="string" required="false" default="" access="private" />
    
    <aura:attribute name="DesignerCmp" type="Object" required="false" default="" access="private" />

<!-- 
================================================
Member data
================================================
-->    
	<aura:attribute name="CurrentRecord" type="sObject" required="false" access="global" />    
	<aura:attribute name="CachedRecordSource" type="string" required="false" default="" access="global" />
	
    <aura:attribute name="TreeContext" type="string" required="false" default="" access="private" />
    <aura:attribute name="RecentlyAmendedClass" type="string" required="false" default="" access="private" />
    <aura:attribute name="TemplateObjectId" type="string" required="false" default="" access="private" />
	<aura:attribute name="KeywordParsedDescription" type="string" required="false" default="" access="public" />

	<aura:attribute name="VideoIframeHeight" type="integer" required="true" default="0" access="private" />
	<aura:attribute name="MediaCheckTimer" type="integer" required="true" default="0" access="private" />
    
    <aura:attribute name="TemplatesC" type="HelpTopicTemplate__c[]" required="false" access="private" />
    <aura:attribute name="TemplatesF" type="HelpTopicTemplate__c[]" required="false" access="private" />
    <aura:attribute name="TemplatesL" type="HelpTopicTemplate__c[]" required="false" access="private" />
    
    <aura:attribute name="CustomStyles" type="sObject[]" required="false" access="private" />
    <aura:attribute name="Visibilities" type="sObject[]" required="false" access="private" />
    <aura:attribute name="VoteSets" type="sObject[]" required="false" access="private" />
    <aura:attribute name="SelectedVoteSet" type="sObject" required="false" access="private" />
    <aura:attribute name="GuidedLayouts" type="sObject[]" required="false" access="private" />
    <aura:attribute name="GuidedElements" type="sObject[]" required="false" access="private" />

    <aura:attribute name="IsHelpTopic" type="boolean" required="true" default="true" access="public" />
    <aura:attribute name="IsNonTopic" type="boolean" required="true" default="false" access="public" />
    
	<aura:attribute name="IsCustomLayout" type="boolean" required="true" default="false" access="public" />
	<aura:attribute name="LayoutInfo" type="string" required="false"  default="" access="global" /> 
	<aura:attribute name="LayoutInfoBackup" type="string" required="false"  default="" access="global" />     
	<aura:attribute name="LayoutInfoDelimiters" type="string" required="true" default="|¬,^" access="global" />
	<aura:attribute name="LayoutInfoPrecedence" type="string" required="false" default="Help Topic" access="global" />

	<aura:attribute name="ToolContextAF" type="string" required="true" default="[DEFAULT]" access="private" />	
    <aura:attribute name="MouseOverDone" type="boolean" default="false" access="public" />



	<div class="{! v.isDirty == true ? 
			'isDirty DOLLAR-color-background-alt CardBodyAutoHeight_' + v.AutoCardHeight : 
			'DOLLAR-color-background-alt CardBodyAutoHeight_' + v.AutoCardHeight}" >

<!-- 
================================================
NO DATA MESSAGE (IF ZERO ROWS ARE AVAILABLE)
================================================
-->
	    <div class="{! (v.IsNonTopic == false &amp;&amp; v.CurrentRecord + '' == '') || (v.IsNonTopic == true &amp;&amp; v.HelpRecordId + '' == '')  ? 'NoDataMessage' : 'slds-hide'}">
	        {!v.NoDataMessage}
	    </div>

<!-- 
================================================
NON-HELP TOPIC MODE
NB: AF's powered by branding is hidden 
as it's invasive in these scenarios
================================================
-->	    
		<aura:if isTrue="{!v.IsNonTopic == true}">		
			<div id="IARecordViewComponentBody">		    	
				<div class="IARecordViewComponentBody">
				
					<c:IHAutoForm aura:id="DetailAF">
						<aura:set attribute="Height" value="-1" />
						<aura:set attribute="SuppressHeader" value="true" />
						<aura:set attribute="SuppressFooter" value="true" />
						<aura:set attribute="SuppressModeTools" value="true" />
						<aura:set attribute="sObjectName" value="{!v.sObjectName}" />
						<aura:set attribute="recordId" value="{!v.HelpRecordId}" />
						<aura:set attribute="CalloutOption" value="Topic Selected Event plus Topic view" />
						<aura:set attribute="OnSaveAction" value="Report only" />
						<aura:set attribute="ComponentId" value="{!v.ComponentId + '_Autoform'}" />
						<aura:set attribute="ListensTo" value="{!v.ListensTo}" />
						<aura:set attribute="ToolContext" value="{!v.ToolContextAF}" />
						<aura:set attribute="DataMode" value="{!v.DataMode}" />

						<aura:set attribute="SuppressPoweredBy" value="true" />                						
					</c:IHAutoForm>
					
				</div>		    	 
		    </div>
	    </aura:if>

<!-- 
================================================
TOPIC MODE - VIEW
================================================
-->
		
<aura:if isTrue="{!v.IsHelpTopic == true &amp;&amp; v.DataMode == 'View' || v.DataMode == 'InlineEdit'}">

			<!-- Mouse over ensures we get editing tools - required for vote question text -->
			<div onmouseover="{!c.initialiseEditingControls}" 

class="{! v.DataMode == 'View' || v.DataMode == 'InlineEdit' ? v.CurrentRecord.iahelp__CustomStyle__c + ' ' + v.RecentlyAmendedClass : 'slds-hide'}">

<!-- 
................................................
Layout designer component, if definition provided
................................................
-->	            
				<aura:if isTrue="{!v.LayoutInfo != ''}">
					<c:IHDetailDesigner aura:id="theDesigner">
						<aura:set attribute="LayoutInfo" value="{!v.LayoutInfo}" />
                        <aura:set attribute="LayoutInfoBackup" value="{!v.LayoutInfoBackup}" />
						<aura:set attribute="Delimiters" value="{!v.LayoutInfoDelimiters}" />
						<aura:set attribute="CurrentRecord" value="{!v.CurrentRecord}" />		
						<aura:set attribute="ParentControl" value="{!this}" />		
					</c:IHDetailDesigner>					
				</aura:if>

<!-- 
................................................
Standard topic layout if NO designer in play
................................................
-->	            
				<aura:if isTrue="{!v.LayoutInfo == ''}">
	
<!-- 
................................................
Summary
................................................
-->	            
		            <div class="slds-col slds-size_1-of-1 slds-m-vertical_medium slds-p-horizontal_small">
			            <div class="slds-text-heading_medium">

<aura:if isTrue="{!v.DataMode == 'View'}">			                

			                <p class='Centred IHLUXDetailSummary'>
			                    <a style="{! 'color: #' + v.GlobalSettings.iahelp__BrandColour6__c + ';'}"
			                    		aura:id="theTopicViewer" 
			                    		ondragstart="{!c.doDragStart}" 
			                    		ondragover="{!c.doDragOver}" 
			                    		ondragleave="{!c.doDragLeave}" 
			                    		ondrop="{!c.doDrop}" 
			                    		ondragend="{!c.doDragEnd}">
			                    	{!v.CurrentRecord.iahelp__Summary__c}
			                    </a>
			                </p>	

</aura:if>

<aura:if isTrue="{!v.DataMode == 'InlineEdit'}">
	<c:IHLTopicSelector>
		<aura:set attribute="InputType" value="TextArea" />
		<aura:set attribute="recordId" value="{!v.CurrentRecord.Id}" />
		<aura:set attribute="FieldName" value="iahelp__Summary__c" />
		<aura:set attribute="FieldValue" value="{!v.CurrentRecord.iahelp__Summary__c}" />
		<aura:set attribute="FieldClass" value="Centred IHLUXDetailSummary" />
	</c:IHLTopicSelector>
</aura:if>

		                </div>							
		            </div>

<!-- 
................................................
Remaining topic details
................................................
-->
		            <div class="slds-col slds-size_1-of-1 slds-m-vertical_medium slds-p-horizontal_small">
		
		                <!-- Media container - responsive, two column container for current full topic template -->
		                <div class="slds-grid slds-wrap">
	                        
							<div class="{! v.CurrentRecord.iahelp__VideoURL__c != null
									? 'slds-col slds-align_absolute-center slds-size_1-of-1 slds-medium-size_1-of-2 slds-large-size_1-of-2' 
									: 'slds-col slds-align_absolute-center slds-size_1-of-1'}">                                                
		    
	                            <!-- Image container -->                    
								<div class="{! v.CurrentRecord.iahelp__ImageURL__c == null ? 'slds-hide' : 'IHDetailMediaImageContainer'}" >
	                            
	                                <div>		
										<p class="HelpTopic Image Title ViewMode slds-text-align_center slds-text-heading_small">
			                            	{!v.CurrentRecord.iahelp__ImageTitle__c}
	
											<aura:if isTrue="{! v.CurrentRecord.iahelp__ImageURL__c != null &amp;&amp; v.CurrentRecord.iahelp__ImageURL__c != ''}">
												<span onclick="{!c.doLightBox}" 
														data-MediaMode="Image"	
														title="{!v.TipButtonFullSizeImage}" 
														class="IATool fa-lg slds-float_right"
														style="{! 'color: #' + v.GlobalSettings.iahelp__BrandColour6__c  + ';'}">
														
												    <i data-MediaMode="Image" class="{! 'fa fa-external-link'}" aria-hidden="true"></i>
												</span>
											</aura:if>
			                            	
										</p>
			                        
										<div style="{! 'width: ' + v.CurrentRecord.iahelp__ImageWidth__c 
												+ 'px; height: ' + v.CurrentRecord.iahelp__ImageHeight__c 
			                                    + 'px; background: url(\'' + v.CurrentRecord.iahelp__ImageURL__c + '\') no-repeat center; ' 
			                                    + 'background-size: ' + v.CurrentRecord.iahelp__ImageWidth__c + 'px ' + v.CurrentRecord.iahelp__ImageHeight__c + 'px;'}"
			                                 
											class="IHDetailMediaImage"		
			                                 title="{!v.TipButtonFullSizeImage}"
			                                 data-MediaMode="Image"
				                             onclick="{!c.doLightBox}">
				                        </div>
			                        
	                                    <div class="slds-text-align_center">
	                                        {!v.CurrentRecord.iahelp__ImageCaption__c}
	                                    </div>
				                    </div>
								</div>	                    
							</div>
	                        
	                        <div class="{! v.CurrentRecord.iahelp__ImageURL__c != null
	                                    ? 'slds-col slds-align_absolute-center slds-size_1-of-1 slds-medium-size_1-of-2 slds-large-size_1-of-2' 
	                                    : 'slds-col slds-align_absolute-center slds-size_1-of-1'}">
	        
	                            <!-- Video -->
								<div class="{! v.CurrentRecord.iahelp__VideoURL__c == null ? 'slds-hide' : 'IHDetailMediaVideoContainer'}" >
	                            
	                                <div>
	                            
	                                    <div class="HelpTopic Video Title ViewMode slds-text-align_center slds-text-heading_small">
	                                        {!v.CurrentRecord.iahelp__VideoTitle__c}
	                                        
											<aura:if isTrue="{! v.CurrentRecord.iahelp__VideoURL__c != null &amp;&amp; v.CurrentRecord.iahelp__VideoURL__c != ''}">
												<span onclick="{!c.doLightBox}" 
														data-MediaMode="Video"
														title="{!v.TipButtonFullSizeImage}" 
														class="IATool fa-lg slds-float_right"
														style="{! 'color: #' + v.GlobalSettings.iahelp__BrandColour6__c  + ';'}">
														
												    <i data-MediaMode="Video" class="{! 'fa fa-external-link'}" aria-hidden="true"></i>
												</span>
											</aura:if>
	                                        
	                                    </div>
	                                    
	                                    <div class="slds-align_absolute-center">
	                                        <iframe aura:id="TopicVideoIframe"
	                                        		class="{! v.CurrentRecord.iahelp__VideoURL__c != null ? '' : 'slds-hide'}" 
	                                        		frameborder="0" 
	                                        		allowfullscreen="allowfullscreen"
	                                                src="{!v.CurrentRecord.iahelp__VideoURL__c}" 
													style="{! 'height: ' + v.VideoIframeHeight + 'px; width: ' + v.CurrentRecord.iahelp__VideoWidth__c + 'px;'}" >
	                                        </iframe>                                                                 
	                                    </div>                                
	                                    
	                                    <div class="slds-text-align_center">
	                                        {!v.CurrentRecord.iahelp__VideoCaption__c}
	                                    </div>
	                                </div>
	                            </div>
							</div>	                    
		                </div>
	    		
		                <!-- 
		                Topic Description : note that for viewing ONLY we use the keyword parsed version,
		                i.e., the one containing links to keyword topics...
		                -->
		                <div class="slds-col slds-size_1-of-1 slds-m-vertical_medium slds-text-longform HelpTopic Description ViewMode">
							<aura:unescapedHtml value="{! v.CachedRecordSource == '' ? v.KeywordParsedDescription : v.KeywordParsedDescription != '' ? v.KeywordParsedDescription : v.CurrentRecord.iahelp__Description__c}" />
                        </div>
	                
	                
						<!-- 
						Vote Options, where a vote is specified for this Topic:
						
						NB: we don't want vote options to appear on their own in advance of any accompanying question text - but
						the latter is not available until editing controls have been sought (just-in-time loading for performance reasons).
						However, we cannot render on the basis of question text, as this may or may not actually be in play (some votes
						do not have question texts). SO: render on the basis of definitive availability of editing controls (and thus 
						question text where relevant). This can be checked via topic callout pick list values... 
						 -->
	
		                <aura:if isTrue="{!v.TemplatesC.length > 0 &amp;&amp; v.SelectedVoteSet.Id != null}">
		                
							<div class="slds-text-body_regular IHDetailVoteSetInfo" >

								<div class="Centred">
									<div class="slds-text-body_regular slds-m-vertical_small DisplayInline">
				                    		
										<img class="{!v.SelectedVoteSet + '' != '' &amp;&amp; v.SelectedVoteSet.iahelp__ImageClass__c + '' != '' ? 'IHDetailVoteSetImage' : 'slds-hide'}" 
												src="{!v.SelectedVoteSet.iahelp__ImageClass__c}" />
												
										<span class="IHDetailVoteQText">
				                        	{!v.SelectedVoteSet + '' != '' ? v.SelectedVoteSet.iahelp__QuestionText__c : ''}
										</span>
		
				                    </div>
								</div>	                    		
		                    </div>

							<div class="Centred IHDetailVoteOptionsContainer">
				                <aura:iteration items="{!v.VoteOptions}" var="VO">
									<div class="VoteOption">
										<a id="{! 'link_' + VO.Id + v.Delimiter + (VO.iahelp__OptionLabel__c == '' || VO.iahelp__OptionLabel__c == null ? VO.Name : VO.iahelp__OptionLabel__c)}"
					                			class="{!v.theVote == VO.Id ? 'LastVote' : ''}" 
					                			href="javascript:void(0);" 
												title="{!v.TipVote + ' - ' + VO.Name}"			                			
					                			onclick="{!c.castVote}">		                	
									
										
											<span id="{! 'badge_' + VO.Id + v.Delimiter + (VO.iahelp__OptionLabel__c == '' || VO.iahelp__OptionLabel__c == null ? VO.Name : VO.iahelp__OptionLabel__c)}" 
													class="{!v.theVote == VO.Id ? 'slds-badge slds-badge_lightest slds-theme_inverse' : 'slds-badge slds-badge_lightest'}">
												
												<span id="{! 'IconSpan_' + VO.Id + v.Delimiter + (VO.iahelp__OptionLabel__c == '' || VO.iahelp__OptionLabel__c == null ? VO.Name : VO.iahelp__OptionLabel__c)}" 
														class="slds-icon_container slds-m-right_xx-small" >
											
													<img id="{! 'Icon_' + VO.Id + v.Delimiter + (VO.iahelp__OptionLabel__c == '' || VO.iahelp__OptionLabel__c == null ? VO.Name : VO.iahelp__OptionLabel__c)}" 
														class="{!VO.iahelp__ImageClass__c == '' || VO.iahelp__ImageClass__c == null ? 'slds-hide' : 'IHDetailVoteOption'}" 
														src="{!VO.iahelp__ImageClass__c}" 
														alt="{!VO.iahelp__OptionLabel__c}" />
											
												</span>
			
												{!VO.iahelp__OptionLabel__c}
											</span>		                	
										</a> &#32;&nbsp;&#32;
									</div>
				                </aura:iteration>
							</div>
		                
		                </aura:if>
		            </div>

				</aura:if>	<!-- End if standard layout, NOT designer, is in play -->

<!-- 
................................................
Optional, template driven sub-component
................................................
-->
					<div class="IHGeneratedChild slds-col slds-size_1-of-1 slds-m-vertical_medium slds-p-horizontal_small">
						<c:IHComponentGenerator aura:id="CGIHDetail">
						    <aura:set attribute="Parent" value="{!this}" />
							<aura:set attribute="SuppressPoweredBy" value="true" />						    
						</c:IHComponentGenerator>
					</div>


		    </div>		   
		</aura:if>	<!-- End if data mode = VIEW Help Topic -->
		
<!-- 
================================================
TOPIC MODE - EDIT
================================================
-->
		<aura:if isTrue="{!v.IsHelpTopic == true &amp;&amp; v.DataMode == 'Edit'}">
		    <div onmouseover="{!c.initialiseEditingControls}" class="{! v.DataMode == 'Edit' ? 'IHDetailEditorContainer' : 'slds-hide'}" >
		    
				<!-- NOTE: need to take body tools height into account here -->		   
				<div style="{! 'height: Calc(100% - ' + (70 + v.H_BodyTools) + 'px);'}" class="slds-tabs_default HelpTopic EditMode">
	
<!-- 
................................................
Tab Headers
................................................
-->
	                <div class="IHDetailTabHeaders">                    
	                	<ul class="slds-tabs_default__nav" role="tablist">
	                	    
	                    	<li aura:id="tabSelector1" onclick="{!c.selectTab}" class="slds-tabs_default__item slds-text-heading_label slds-active" title="" role="presentation">
	                    	    <a class="slds-tabs_default__link" href="javascript:void(0);" role="tab" tabindex="0" aria-selected="true" aria-controls="HelpTopicEditTab1">
									{!v.TitleTabVisible}
	                            </a>
	                        </li>
	                    	
	                    	<li aura:id="tabSelector2" onclick="{!c.selectTab}" class="slds-tabs_default__item slds-text-heading_label" title="" role="presentation">
	                    	    <a class="slds-tabs_default__link" href="javascript:void(0);" role="tab" tabindex="-1" aria-selected="false" aria-controls="HelpTopicEditTab2">
									{!v.TitleTabGeneral}
	                	        </a>
	                        </li>
	                        
	                    	<li aura:id="tabSelector3" onclick="{!c.selectTab}" 
	                    			class="{! v.CustomFields.length > 0 ? 'slds-tabs_default__item slds-text-heading_label' : 'slds-hide slds-tabs_default__item slds-text-heading_label'}" 
	                    			title="" role="presentation">

	                    	    <a class="slds-tabs_default__link" href="javascript:void(0);" role="tab" tabindex="-1" aria-selected="false" aria-controls="HelpTopicEditTab3">
									{!v.TitleTabCustom}
	                	        </a>
	                        </li>								  
                            
                            <li aura:id="tabSelector4" onclick="{!c.selectTab}" class="slds-tabs_default__item slds-text-heading_label" title="" role="presentation">
	                    	    <a class="slds-tabs_default__link" href="javascript:void(0);" role="tab" tabindex="-1" aria-selected="false" aria-controls="HelpTopicEditTab4">
									{!v.TitleTabStatus}
	                	        </a>
	                        </li>
	                
	                    	<li aura:id="tabSelector5" onclick="{!c.selectTab}" class="slds-tabs_default__item slds-text-heading_label" title="" role="presentation">
	                    	    <a class="slds-tabs_default__link" href="javascript:void(0);" role="tab" tabindex="-1" aria-selected="false" aria-controls="HelpTopicEditTab5">
									{!v.TitleTabText}
	                	        </a>
	                        </li>
	    
	                    	<li aura:id="tabSelector6" onclick="{!c.selectTab}" class="slds-tabs_default__item slds-text-heading_label" title="" role="presentation">
	                    	    <a class="slds-tabs_default__link" href="javascript:void(0);" role="tab" tabindex="-1" aria-selected="false" aria-controls="HelpTopicEditTab6">
									{!v.TitleTabGuides}
	                	        </a>
	                        </li>
	                
	                     </ul>
	                </div>
	    
<!-- 
................................................
Visible fields tab
................................................
-->
		            <div aura:id="HelpTopicEditTab1" class="slds-tabs_default__content slds-show slds-scrollable_y TabPanel" role="tabpanel" aria-labelledby="HelpTopicEditItemTab1">
	                    <div class="slds-grid"  >
	                        <div class="slds-col slds-p-horizontal_small">
	                            
	                            <!-- Name & Summary -->
	                	        <div class="slds-text-heading_small slds-m-vertical_small">
									<ui:inputText value="{!v.CurrentRecord.Name}" maxlength="80" placeholder="{!v.FieldLabelName}" change="{!c.setDirty}"/>
	                	        </div>
	                	        
	                            <div class="slds-text-body_regular slds-m-bottom_small">
                     
									<lightning:input value="{!v.CurrentRecord.iahelp__Summary__c}" onchange="{!c.setDirty}"
											variant="label-hidden" type="text"
											required="true" messageWhenValueMissing="{!v.MessageValueRequired}"
											placeholder="{!v.FieldLabelSummary}" maxlength="255" />
											
	                            </div>
	                            
	                            <!-- Media -->
	                            <div class="slds-grid slds-gutters_x-small slds-wrap">
	                
	                                <!-- Image -->
	                                <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-1 slds-large-size_1-of-2">
	
                                        <div class="slds-m-vertical_small slds-text-align_center slds-text-heading_small">
                                            <ui:inputText aura:id="txtImgTitle" value="{!v.CurrentRecord.iahelp__ImageTitle__c}" placeholder="{!v.FieldLabelImageTitle}"  maxlength="255" change="{!c.setDirty}"/>
                                        </div>                                            

<span onclick="{!c.resetImage}" 
		data-MediaMode="Image"	
		title="{!v.TipButtonResetImage}" 
		class="IATool fa-lg slds-float_right"
		style="{! 'color: #' + v.GlobalSettings.iahelp__BrandColour6__c  + ';'}">
		
    <i data-MediaMode="Image" class="fa fa-times" aria-hidden="true"></i>
</span>
                                        
                                        <div style="{! 'width: ' + v.CurrentRecord.iahelp__ImageWidth__c 
                                                    + 'px; height: ' + v.CurrentRecord.iahelp__ImageHeight__c 
                                                    + 'px; background: url(\'' + v.CurrentRecord.iahelp__ImageURL__c + '\') no-repeat center; ' 
                                                    + 'background-size: ' + v.CurrentRecord.iahelp__ImageWidth__c + 'px ' + v.CurrentRecord.iahelp__ImageHeight__c + 'px;'}"
                                                    
                                                    class="IHDetailMediaImage">
                                        </div>
                                        
                                        <div class="slds-m-vertical_small slds-text-align_center">
                                            <ui:inputText aura:id="txtImgCaption" value="{!v.CurrentRecord.iahelp__ImageCaption__c}" placeholder="{!v.FieldLabelImageCaption}" maxlength="255" change="{!c.setDirty}"/>
                                        </div>

                                                                        
	                                    <!-- Image detail parameters panel -->
                                        <div aura:id="ImgEditor" class="slds-section ParameterEditMenu">

											<h3 onclick="{!c.toggleImageEdit}" class="slds-accordion__summary-heading">
												<button type="button"
														aria-controls="ImageParameterPanel" 
														class="slds-button slds-section__title-action"
														>
								
													<lightning:icon aura:id="ImgEditor_Twisty" class="slds-button__icon" size="xx-small" iconName="utility:chevronright"/>
									
													<span class="slds-truncate" title="{!v.TipButtonSettings}">
														{!v.TitleTabImage}: {!v.AdviceLabelProperties}										
													</span>
												</button>
							        		</h3>
		                                            
                                            <div aria-hidden="false" class="slds-section__content" id="ImageParameterPanel">
                                            
                                                {!v.FieldLabelImageURL}
                                                <ui:inputText class="" aura:id="txtImgURL" value="{!v.CurrentRecord.iahelp__ImageURL__c}" maxlength="255" change="{!c.setDirty}"/>
                                                
                                                {!v.FieldLabelImageALTText} 
                                                <ui:inputText class="" aura:id="txtImgALTText" value="{!v.CurrentRecord.iahelp__ImageALTText__c}" maxlength="255" change="{!c.setDirty}"/>
                                                
                                                {!v.FieldLabelImageWidth} 
                                                <ui:inputNumber class="" aura:id="txtImgWidth" value="{!v.CurrentRecord.iahelp__ImageWidth__c}" change="{!c.setDirty}"/>  
                                                
                                                {!v.FieldLabelImageHeight} 
                                                <ui:inputNumber class="" aura:id="txtImgHeight" value="{!v.CurrentRecord.iahelp__ImageHeight__c}" change="{!c.setDirty}"/>
                                                
                                            </div>
                                        </div>		                                        
	                                </div>
	                                
	                                <!-- Video -->
	                                <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-1 slds-large-size_1-of-2">
	                
                                        <div class="slds-m-vertical_small slds-text-align_center slds-text-heading_small">
                                            <ui:inputText aura:id="txtVidTitle" value="{!v.CurrentRecord.iahelp__VideoTitle__c}" placeholder="{!v.FieldLabelVideoTitle}" maxlength="255" change="{!c.setDirty}"/>
                                        </div>                                           

<span onclick="{!c.resetVideo}" 
		data-MediaMode="Image"	
		title="{!v.TipButtonResetVideo}" 
		class="IATool fa-lg slds-float_right"
		style="{! 'color: #' + v.GlobalSettings.iahelp__BrandColour6__c  + ';'}">
		
    <i data-MediaMode="Image" class="fa fa-times" aria-hidden="true"></i>
</span>
                                        
                                        <div class="slds-align_absolute-center">
                                            <iframe class="{! v.CurrentRecord.iahelp__VideoURL__c != null ? '' : 'slds-hide'}" frameborder="0" 
                                                    src="{!v.CurrentRecord.iahelp__VideoURL__c}" 
													style="{! 'height: ' + v.CurrentRecord.iahelp__VideoHeight__c + 'px; width: 100%;'}" ></iframe>
                                        </div>
                                        
                                        <div class="slds-m-vertical_small slds-text-align_center">
                                            <ui:inputText aura:id="txtVidCaption" value="{!v.CurrentRecord.iahelp__VideoCaption__c}" placeholder="{!v.FieldLabelVideoCaption}" maxlength="255" change="{!c.setDirty}"/>
                                        </div>                                           
                                           	                
                                	    <!-- Video detail parameters panel -->
                                        <div aura:id="VidEditor" class="slds-section ParameterEditMenu">

											<h3 onclick="{!c.toggleVideoEdit}" class="slds-accordion__summary-heading">
												<button type="button"
														aria-controls="VideoParameterPanel" 
														class="slds-button slds-section__title-action"
														>
								
													<lightning:icon aura:id="VidEditor_Twisty" class="slds-button__icon" size="xx-small" iconName="utility:chevronright"/>
									
													<span class="slds-truncate" title="{!v.TipButtonSettings}">
														{!v.TitleTabVideo}: {!v.AdviceLabelProperties}										
													</span>
												</button>
							        		</h3>
                                           
                                            <div aria-hidden="false" class="slds-section__content" id="VideoParameterPanel">
                                            
                                                {!v.FieldLabelVideoURL} 
                                                <ui:inputText class="Parameter" aura:id="txtVidURL" value="{!v.CurrentRecord.iahelp__VideoURL__c}" maxlength="255" change="{!c.setDirty}"/>

												{!v.FieldLabelVideoWidth} 
                                                <ui:inputNumber class="Parameter" aura:id="txtVidWidth" value="{!v.CurrentRecord.iahelp__VideoWidth__c}" change="{!c.setDirty}"/>  

												{!v.FieldLabelVideoHeight}
                                                <ui:inputNumber class="Parameter" aura:id="txtVidHeight" value="{!v.CurrentRecord.iahelp__VideoHeight__c}" change="{!c.setDirty}"/>                                         
                                            
                                            </div>
                                        </div>
	                                </div>
	                            </div>
	                        </div>
	                    </div>
	            	</div>    
		
<!-- 
