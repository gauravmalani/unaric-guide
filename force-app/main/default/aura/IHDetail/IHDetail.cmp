	                <div aura:id="HelpTopicEditTab2" class="slds-tabs_default__content slds-hide slds-scrollable_y TabPanel" role="tabpanel" aria-labelledby="HelpTopicEditItemTab2">
	                    <div class="slds-grid">
	                        <div class="slds-col slds-p-horizontal_small">

	                            <div class="slds-text-body_regular slds-m-vertical_small">                            
									{!v.FieldLabelMasterTopicIdentifier} <ui:inputText value="{!v.CurrentRecord.iahelp__MasterTopicIdentifier__c}" maxlength="255" change="{!c.setDirty}"/>
	                            </div>

	                            <div class="slds-text-body_regular slds-m-vertical_small">                            
									{!v.FieldLabelSFHelpURL} <ui:inputText value="{!v.CurrentRecord.iahelp__SalesforceHelpURL__c}" maxlength="255" change="{!c.setDirty}"/>
	                            </div>
	                            
	                            <div class="slds-text-body_regular slds-m-vertical_small">
	                                {!v.FieldLabelCalloutTemplate} <ui:inputSelect aura:id="CalloutTemplate" multiple="false" change="{!c.setDirty}">
	                                    <aura:iteration items="{!v.TemplatesC}" var="Opt">
											<ui:inputSelectOption text="{!Opt.Id}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__CalloutTemplate__c == Opt.Id}" />
	                                    </aura:iteration>        
	                                </ui:inputSelect>
	                            </div>
	                            
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelCalloutHeight} 
									<lightning:input value="{!v.CurrentRecord.iahelp__CalloutHeight__c}" onchange="{!c.setDirty}"
											variant="label-hidden" type="number"
											required="true" messageWhenValueMissing="{!v.MessageValueRequired}" />

	                            </div>
	                            
	                            <div class="slds-text-body_regular slds-m-vertical_small">
	                                {!v.FieldLabelCalloutMediaChoice} <ui:inputSelect aura:id="CalloutMediaChoice" multiple="false" change="{!c.setDirty}">
										<ui:inputSelectOption label="Image" text="Image" value="{!v.CurrentRecord.iahelp__CalloutMediaChoice__c == 'Image'}" />
										<ui:inputSelectOption label="Video" text="Video" value="{!v.CurrentRecord.iahelp__CalloutMediaChoice__c == 'Video'}" />
	                                </ui:inputSelect>    
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
	                                <a href="javascript:void()" onclick="{!c.previewCallout}" title="{!v.TipButtonPreviewCallout}">
										{!v.ButtonPreviewCallout} 
	                                </a>
	                                
	                                : : :
	                                
									<a href="javascript:void()" onclick="{!c.previewCalloutAsEdited}" title="{!v.TipButtonPreviewCalloutAsEdited}">
										{!v.ButtonPreviewCalloutAsEdited} 
									</a>
	                                
	                                : : :

									<a href="javascript:void()" onclick="{!c.gotoTemplates}" title="{!v.TipButtonGotoTemplates}">
										{!v.ButtonGotoTemplates} 
									</a>
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelFullTemplate} <ui:inputSelect aura:id="Template" multiple="false" change="{!c.setDirty}">
	                                    <aura:iteration items="{!v.TemplatesF}" var="Opt">
	                                        <ui:inputSelectOption text="{!Opt.Id}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__Template__c == Opt.Id}" />
	                                    </aura:iteration>        
	                                </ui:inputSelect>
	                            </div>

								<div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelLightningTemplate} <ui:inputSelect aura:id="LightningTemplate" multiple="false" change="{!c.setDirty}">
								    	<aura:iteration items="{!v.TemplatesL}" var="Opt">
											<ui:inputSelectOption text="{!Opt.Id == null ? v.NullValue : Opt.Id}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__LightningTemplate__c == Opt.Id}" />
								    	</aura:iteration>        
									</ui:inputSelect>
								</div>

	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelHeightBeforeScrolling} 
									<lightning:input value="{!v.CurrentRecord.iahelp__HeightBeforeScrolling__c}" onchange="{!c.setDirty}"
											variant="label-hidden" type="number"
											required="true" messageWhenValueMissing="{!v.MessageValueRequired}" />

	                            </div>
	                        </div>
	                    </div>
	            	</div>
		
<!-- 
................................................
Custom fields Tab
................................................
-->
	                <div aura:id="HelpTopicEditTab3" class="slds-tabs_default__content slds-hide slds-scrollable_y TabPanel" role="tabpanel" aria-labelledby="HelpTopicEditItemTab3">
	            	    <div class="slds-grid">
	            	        <div class="slds-col slds-p-horizontal_small">
	
	        	                <aura:iteration items="{!v.CustomFields}" var="CF">

<!-- 
NEED TO DEAL WITH:
PICK LIST TYPES
LOOKUPS
 -->
	
	                                <!--
	                                As we iterate around custom fields, respond to field type, 
	                                hiding all but the required control (note text box as default
	                                when field is not of another known type)
	                                -->
	                                <aura:if isTrue="{!CF.CustomField.type != 'boolean' &amp;&amp; CF.CustomField.type != 'currency' 
	                                                &amp;&amp; CF.CustomField.type != 'date' &amp;&amp; CF.CustomField.type != 'datetime' 
	                                                &amp;&amp; CF.CustomField.type != 'email' &amp;&amp; CF.CustomField.type != 'url' 
	                                                &amp;&amp; CF.CustomField.type != 'integer' &amp;&amp; CF.CustomField.type != 'double' 
	                                                &amp;&amp; CF.CustomField.type != 'textarea'}">
	                                                
		                                <div class="slds-text-body_regular slds-m-vertical_small">
		                                    <ui:inputText aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
		                                </div> 
	                                </aura:if>       	                    
	
									<aura:if isTrue="{! CF.CustomField.type == 'boolean'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputCheckBox aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'currency'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputCurrency aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'date'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputDate aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}" displayDatePicker="true"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'datetime'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputDateTime aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}" displayDatePicker="true"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'email'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputEmail aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'integer' || CF.CustomField.type == 'double'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputNumber aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'textarea'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputTextArea aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
										</div>
									</aura:if>
										
									<aura:if isTrue="{! CF.CustomField.type == 'url'}"	>
										<div class="slds-text-body_regular slds-m-vertical_small">
											<ui:inputURL aura:id="CUSTOMFIELD" labelClass="{!CF.CustomField.fieldPath}" label="{!CF.CustomField.label}" value="{!CF.Val}" change="{!c.setDirty}"/>
										</div>
									</aura:if>
	
	    	                    </aura:iteration>
	
	            	        </div>
	            	    </div>
	            	</div>
		
<!-- 
................................................
Status Tab
................................................
-->
	                <div aura:id="HelpTopicEditTab4" class="slds-tabs_default__content slds-hide slds-scrollable_y TabPanel" role="tabpanel" aria-labelledby="HelpTopicEditItemTab4">
	                    <div class="slds-grid">
	            	        <div class="slds-col slds-p-horizontal_small">
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelActive} <ui:inputCheckbox value="{!v.CurrentRecord.iahelp__Active__c}" change="{!c.setDirty}"/>
	                            </div>
	                            
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelShowReadMore} <ui:inputCheckbox value="{!v.CurrentRecord.iahelp__ShowReadMoreLink__c}" change="{!c.setDirty}"/>
	                            </div>
	                            
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelShowReferringTopics} <ui:inputCheckbox value="{!v.CurrentRecord.iahelp__ShowReferringRelationships__c}" change="{!c.setDirty}"/>
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelStatus} <ui:inputSelect aura:id="HelpTopicStatus" multiple="false" change="{!c.setDirty}">
										<ui:inputSelectOption text="New" label="New" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'New'}"/>
										<ui:inputSelectOption text="Drafted" label="Drafted" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'Drafted'}"/>
										<ui:inputSelectOption text="Submitted for Approval" label="Submitted for Approval" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'Submitted for Approval'}"/>
										<ui:inputSelectOption text="Approved" label="Approved" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'Approved'}"/>
										<ui:inputSelectOption text="Published" label="Published" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'Published'}"/>
										<ui:inputSelectOption text="Suspended" label="Suspended" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'Suspended'}"/>
										<ui:inputSelectOption text="Obsolete" label="Obsolete" value="{!v.CurrentRecord.iahelp__HelpTopicStatus__c == 'Obsolete'}"/>
	                                </ui:inputSelect>
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelVisibility} <ui:inputSelect aura:id="Visibility" multiple="false" change="{!c.setDirty}">
	                                    <aura:iteration items="{!v.Visibilities}" var="Opt">
	                                        <ui:inputSelectOption text="{!Opt.Value == null ? v.NullValue : Opt.Value}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__Visibility__c == Opt.Value}" />
	                                    </aura:iteration>        
	                                </ui:inputSelect>
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelCustomStyle} <ui:inputSelect aura:id="CustomStyle" multiple="false" change="{!c.setDirty}">
	                                    <aura:iteration items="{!v.CustomStyles}" var="Opt">
	                                        <ui:inputSelectOption text="{!Opt.Value}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__CustomStyle__c == Opt.Value}" />
	                                    </aura:iteration>        
	                                </ui:inputSelect>
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelVoteInfo} <ui:inputSelect aura:id="HelpVoteSet" multiple="false" change="{!c.setDirty}">
	                                    <aura:iteration items="{!v.VoteSets}" var="Opt">
	                                        
	                                        <!-- 
	                                        NOTE: for "None" drop down entry, we need to use a value that positively
	                                        specifies "null" - as attempting to use a plain null in an option results in
	                                        no discernable value, so the drop down entry can never be reliably selected
	                                        -->
	                                        <ui:inputSelectOption text="{!Opt.Id == null ? v.NullValue : Opt.Id}" label="{!Opt.Name}" value="{!v.CurrentRecord.iahelp__HelpVoteSet__c == Opt.Id}" />
	                                    </aura:iteration>        
	                                </ui:inputSelect>
	                            </div>
	
	                            <div class="slds-text-body_regular slds-m-vertical_small">
	                               <span class="IHDetailVoteQText">
	                                   {!v.SelectedVoteSet + '' != '' ? v.SelectedVoteSet.iahelp__QuestionText__c : ''}
	                               </span>
	                            </div>
	                            
	                            <div class="slds-text-body_regular slds-m-vertical_small">
	                               <img src="{!v.SelectedVoteSet + '' != '' ? v.SelectedVoteSet.iahelp__ImageClass__c : ''}" class="IHDetailVoteSetImage" />
	                            </div>
	
	            	           <div class="slds-text-body_regular slds-m-vertical_small">
	                                <a href="javascript:void()" onclick="{!c.maintainVoteSets}">
										{!v.ButtonGotoVoteSets}
	                                </a>
	            	           </div>
	                        </div>
	                    </div>
	            	</div>
		
