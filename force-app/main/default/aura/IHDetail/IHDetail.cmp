Rich Text
................................................
-->
	                <div aura:id="HelpTopicEditTab5" class="slds-tabs_default__content slds-hide slds-scrollable_y TabPanel" role="tabpanel" aria-labelledby="HelpTopicEditItemTab5">
	                	<div class="slds-grid">
	                		<div class="slds-col slds-p-horizontal_small">
			                    <div class="slds-col slds-size_1-of-1 slds-m-vertical_medium slds-p-horizontal_small slds-text-longform HelpTopic Description EditMode">
									
									<lightning:inputRichText 
											formats="['font', 'size', 'bold', 'italic', 'underline',
									            'strike', 'list', 'indent', 'align',
									            'clean', 'table', 'header', 'color', 'link']"
									            
											value="{!v.CurrentRecord.iahelp__Description__c}" onblur="{!c.setDirty}">
									
									</lightning:inputRichText>
			                    
			                    </div>
			
			                    <div class="slds-text-body_regular slds-m-vertical_small">
									{!v.FieldLabelKeywords} <ui:inputText value="{!v.CurrentRecord.iahelp__Keyword__c}" maxlength="255" change="{!c.setDirty}"/>
			                    </div>
		                    </div>
