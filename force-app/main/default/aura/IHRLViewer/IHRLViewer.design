<design:component label="Improved Help: Reading List Viewer">
 
<!-- 
================================================
SHARED SETTINGS
================================================
 -->
	<design:attribute name="RLStyle" 
	                label="Component Style" 
	                description="Controls the overall visual treatment of the Reading List." 
                    datasource="Adopter,Carousel,Standard"
                    default="Adopter" 
                    required="true" />	

    <design:attribute name="Height" 
	                label="Standard + Carousel Only: Component Height" 
	                description="Initial display height for this component (pixels)." 
	                default="-1"
                    required="true" />	

    <design:attribute name="HelpRecordId" 
                    label="Default Reading List" 
                    description="Id of the Reading List to display on loading (leave blank to await instructions from the component this one 'listens to')." 
	                default=""
                    required="false" />	

	<design:attribute name="SuppressHeader" 
	                label="Suppress Header" 
	                description="Check this box to hide the header area of this component." 
	                default="false"
                    required="false" />	

	<design:attribute name="UXTheme" 
	                label="Colour Scheme" 
	                description="Enter the name of a styling theme to override the global default Help colour scheme (available themes typically include 'Light' and 'Dark'). Leave blank to accept default theme." 
                    default="Light" 
                    required="false" />	      
	
	<design:attribute name="BackgroundStyle" 
	                label="Background Style" 
	                description="Controls whether to adopt brand background colour for the component as a whole." 
                    datasource="Coloured,Transparent"
                    default="Coloured" 
                    required="true" />	      
	
    <design:attribute name="ComponentId" 
                    label="Component ID" 
                    description="A reference name for this component, used in conjunction with the 'Listens To' parameter." 
                    default="" 
                    required="false" />	

    <design:attribute name="ListensTo" 
                    label="Listens To" 
                    description="Comma-separated list of the component(s) that this component should 'listen' to (respond to events from). To listen to the Quick Access Menu, enter 'theQAM'." 
                    default="" 
                    required="false" />	


<!-- 
================================================
ADOPTER ONLY SETTINGS
================================================
 -->
	<design:attribute name="RLEStyle" 
	                label="Adopter Style Only: Entry Presentation Style" 
	                description="Controls the appearence of Reading List Entries when expanded." 
                    datasource="Simple Text,Minimal Topic,Topic Viewer"
                    default="Simple Text" 
                    required="true" />	

    <design:attribute name="DefaultLayout" 
                    label="Adopter Style Only: Minimum Topic Layout Design" 
                    description="If using 'Minimal Topic' Entry Presentation Style, sets the Topic custom layout to use to display entries." 
                    default="" 
                    required="false" />	

<!-- 
================================================
CAROUSEL ONLY SETTINGS
================================================
 -->
    <design:attribute name="CarouselSpeed" 
                    label="Carousel Style Only: Animation Speed" 
                    description="Controls the speed at which the Carousel slider switches between Entries Enter the number of milliseconds to display each Entry before advancing to the next." 
                    default="4000"
                    required="true" />

<!-- 
================================================
STANDARD ONLY SETTINGS
================================================
 -->
	<design:attribute name="SuppressFooter" 
	                label="Standard Style Only: Suppress Footer" 
	                description="Check this box to hide the footer / diagnostics area of this component." 
	                default="false"
                    required="false" />	

	<design:attribute name="NoDataMessage" 
	                label="Standard Style Only: 'No Data' Advice Label" 
	                description="A message to display on this component when no data is present." 
	                default="[No Data]"
                    required="false" />	

    <design:attribute name="ShowNavBar" 
                    label="Standard Style Only: Show Navigation Bar" 
                    description="Shows or hides the Reading List Entries navigation bar." 
	                default="true"
                    required="false" />	

    <design:attribute name="ShowDescriptions" 
                    label="Standard Style Only: Show Entry Descriptions" 
                    description="Switches the display of Reading List Entry description text on or off." 
                    default="true" 
                    required="false" />	

    <design:attribute name="MediaWidth" 
                    label="Standard Style Only: Media Width" 
                    description="Percentage width at which to display Reading List Entry image and/or video."
                    datasource="50,75,100" 
                    default="50" 
                    required="false" />	

    <design:attribute name="VideoAspectRatio" 
                    label="Standard Style Only: Video Aspect Ratio" 
                    description="Ratio of width to height to use when displaying video media."
                    datasource="HD (16:9),Monitor (4:3),Widescreen (5:3)" 
                    default="HD (16:9)" 
                    required="false" />	

</design:component>