<design:component label="Improved Help: Wizard">

	<design:attribute name="Height" 
	                label="Component Height" 
	                description="Initial display height for this component (pixels)." 
	                default="-2"
                    required="true" />	

	<design:attribute name="SuppressHeader" 
	                label="Suppress Header" 
	                description="Check this box to hide the header area of this component." 
	                default="false"
                    required="false" />	

	<design:attribute name="SuppressFooter" 
	                label="Suppress Footer" 
	                description="Check this box to hide the footer / diagnostics area of this component." 
	                default="false"
                    required="false" />	

	<design:attribute name="NoDataMessage" 
	                label="'No Data' Advice Label" 
	                description="A message to display on this component if no Wizard steps have been retrieved." 
	                default="[No Data]"
                    required="false" />	

	<design:attribute name="WizardName" 
	                label="Default Wizard Name" 
	                description="The name (as defined in Configuration Item records) of the wizard to display in this component." 
	                default=""
                    required="true" />	
                    
    <design:attribute name="ListensTo" 
                    label="Listens To" 
                    description="The ID of a SINGLE component that this component should 'listen' to (respond to events from). To listen to the Quick Access Menu, enter 'theQAM'."
                    default="" 
                    required="false" />
                    
</design:component>